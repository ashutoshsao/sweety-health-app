{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Temporal"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "prisma.config.ts"]
}
